# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported values: deepseek, azure_openai
LLM_PROVIDER=deepseek

# Keep secrets empty in this template. Set the real value only in backend/.env.
LLM_API_KEY=

# DeepSeek: model name, for example deepseek-chat.
# Azure OpenAI: deployment name, not the underlying model name.
LLM_MODEL=deepseek-chat

# DeepSeek example:
LLM_BASE_URL=https://api.deepseek.com/v1

# Azure OpenAI development example:
# LLM_PROVIDER=azure_openai
# LLM_API_KEY=
# LLM_MODEL=your-deployment-name
# LLM_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
# ── Embedding Model (sentence-transformers) ───────────────────────────────────
# Default corpus is English-language regulatory/fund documents.
# Recommended: BAAI/bge-small-en-v1.5 (default, ~130MB)
# Other options: BAAI/bge-base-en-v1.5 (more accurate, ~440MB)
#                BAAI/bge-small-zh-v1.5 (for a Chinese-language regulatory corpus)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ── Documents ─────────────────────────────────────────────────────────────────
# Document directory (default: backend/docs/) — regulatory .txt/.md/.pdf files.
# Markdown files may include a YAML frontmatter block with regulatory metadata
# (regulation_number, issuing_authority, jurisdiction, product_type, risk_level,
# effective_date, status, document_type) — see backend/docs/*.md for examples.
# DOCS_DIR=/path/to/your/documents

# ── Cross-Encoder Reranking (optional) ───────────────────────────────────────
# Uncomment to enable real cross-encoder (downloads ~280MB on first run)
# RERANKER_MODEL=BAAI/bge-reranker-base

# ── RAG Parameters ────────────────────────────────────────────────────────────
MAX_CHUNK_CHARS=900

# ── Knowledge Base Optimizations ─────────────────────────────────────────────
# ⑦ Contextual Chunking (Anthropic, 2024): LLM generates per-chunk context at
#    index time, improving retrieval of ambiguous/short chunks. Requires API key.
#    Adds ~1 LLM call per chunk — run once, then cached.
# CONTEXTUAL_CHUNKING=true

# ⑧ Embedding Cache: automatically saves/loads embeddings to avoid re-encoding
#    unchanged documents on restart. Default: backend/cache/
# CACHE_DIR=/path/to/custom/cache
